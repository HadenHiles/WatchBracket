vote.famflix.live {
  redir https://bracket.famflix.live{uri} permanent
}

bracket.famflix.live {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://bracket.famflix.live wss://bracket.famflix.live; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    -Server
  }

  handle /api/* { reverse_proxy game-api:3001 }
  handle /socket.io/* { reverse_proxy game-api:3001 }
  handle /cast/receiver* {
    header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://bracket.famflix.live wss://bracket.famflix.live; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    reverse_proxy cast-receiver:8080
  }
  handle { reverse_proxy web:3000 }
}
