# Fake development values only. Replace every replace-me value before production.
NODE_ENV=development
PUBLIC_APP_URL=https://bracket.famflix.live
PUBLIC_ALIAS_URL=https://vote.famflix.live
DATABASE_URL=postgres://watchbracket:replace-me@postgres:5432/watchbracket
POSTGRES_DB=watchbracket
POSTGRES_USER=watchbracket
POSTGRES_PASSWORD=replace-me

ADMIN_BOOTSTRAP_EMAIL=host@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-me-with-at-least-12-characters
HOST_SESSION_PEPPER=replace-me-host-session-pepper
PARTICIPANT_SESSION_PEPPER=replace-me-participant-session-pepper
DISPLAY_SESSION_PEPPER=replace-me-display-session-pepper
CSRF_SECRET=replace-me-csrf-signing-secret

GAME_API_INTERNAL_URL=http://game-api:3001
INTEGRATION_SERVICE_INTERNAL_URL=http://integration-service:3002
INTEGRATION_SERVICE_SHARED_SECRET=replace-me-internal-shared-secret

ROOM_CODE_LENGTH=6
ROOM_MAX_PARTICIPANTS=8
ROOM_TTL_HOURS=12
DISPLAY_PAIRING_TTL_SECONDS=300
ENABLE_PRESENTATION_TEST_MODE=true

# Future integration-service-only settings belong in .env.integration.production,
# never in the game-api environment. Not consumed in Milestones 0-1.
# TMDB_API_READ_TOKEN=replace-me
